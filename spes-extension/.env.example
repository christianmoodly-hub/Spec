# Copy to .env and fill in values from the Firebase console
# (Project settings → Your apps → SDK setup and configuration).
# Restart/rebuild after changing these — Vite inlines them at build time.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console → Authentication → Sign-in method → Google → Web client ID
# Also add https://<extension-id>.chromiumapp.org/ as an Authorized redirect URI
# on that same Web OAuth client in Google Cloud Console.
VITE_GOOGLE_WEB_CLIENT_ID=

# Google AI Studio key for job-text extraction (generic fallback)
VITE_GEMINI_API_KEY=
# Optional. Default: gemini-3.6-flash
VITE_GEMINI_MODEL=
